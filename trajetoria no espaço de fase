import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
from mpl_toolkits.mplot3d import Axes3D
import os

# --- 1. MOTOR SIR FRACIONÁRIO ---
def solver_sir_final(alpha, beta, gamma, n_dias, h, i0_abs, N):
    n_steps = int(n_dias / h)
    s, i = np.zeros(n_steps), np.zeros(n_steps)
    i[0] = i0_abs / N
    s[0] = 1.0 - i[0]
    s0, i0_p = s[0], i[0]
    
    w = np.zeros(n_steps)
    w[0] = 1.0
    for j in range(1, n_steps):
        w[j] = w[j-1] * (1 - (alpha + 1) / j)
    
    h_a = h**alpha
    beta_f, gamma_f = beta**alpha, gamma**alpha 
    
    for k in range(1, n_steps):
        fluxo_inf = beta_f * s[k-1] * i[k-1]
        fluxo_rec = gamma_f * i[k-1]
        
        # Memória de Caputo via Grünwald-Letnikov
        memo_s = np.dot(w[1:k+1], s[:k][::-1] - s0)
        memo_i = np.dot(w[1:k+1], i[:k][::-1] - i0_p)
        
        s[k] = s0 - fluxo_inf * h_a - memo_s
        i[k] = i0_p + (fluxo_inf - fluxo_rec) * h_a - memo_i
        
        if i[k] < 0: i[k] = 0 
        if s[k] < 0: s[k] = 0
            
    return s[::int(1/h)][:n_dias], i[::int(1/h)][:n_dias]

# --- 2. CARREGAMENTO E TRATAMENTO DE DADOS ---
caminho = '/home/plinyo/Downloads/dados_covid_sp.csv'
df = pd.read_csv(caminho, sep=';')
if 'nome_munic' not in df.columns: df = pd.read_csv(caminho, sep=',')

bauru = df[df['nome_munic'] == 'Bauru'].copy()
bauru['datahora'] = pd.to_datetime(bauru['datahora'])
bauru = bauru.sort_values('datahora')

# Limpeza e cálculo de I(t)
bauru['casos_novos'] = bauru['casos_novos'].apply(lambda x: float(str(x).replace(',', '.')) if pd.notna(x) else 0.0)
bauru['I_real'] = bauru['casos_novos'].rolling(window=14, min_periods=1).sum()

# Recorte da Janela (Onda 1)
onda = bauru[(bauru['datahora'] >= '2020-05-01') & (bauru['datahora'] <= '2021-04-01')].copy()
y_real = onda['I_real'].values  # AQUI ESTAVA O ERRO (Corrigido de I_ativo para I_real)
datas = onda['datahora'].values
N_bauru = 379146
n_dias = len(y_real)
t = np.arange(n_dias)

# --- 3. GRÁFICO 1: LEQUE DE SENSIBILIDADE 3D ---
fig = plt.figure(figsize=(14, 10))
ax = fig.add_subplot(111, projection='3d')
alphas = [1.0, 0.9, 0.8, 0.7]
cores = ['red', 'orange', 'green', 'royalblue']
BETA, GAMMA = 0.42, 0.12

print("Simulando hélices 3D...")
for idx, a in enumerate(alphas):
    s_v, i_v = solver_sir_final(a, BETA, GAMMA, n_dias, 0.1, y_real[0], N_bauru)
    ax.plot(t, s_v, i_v, color=cores[idx], lw=2.5, label=f'α={a:.1f}')

ax.set_title('Trajetórias no espaço de fase estendido ($t, s, i$)', fontsize=15, fontweight='bold')
ax.set_xlabel('Tempo (Dias)'), ax.set_ylabel('Suscetíveis (s)'), ax.set_zlabel('Infectados (i)')
ax.view_init(elev=20, azim=-60)
ax.legend()
plt.savefig('leque_3d_final.png', dpi=300)
plt.show()

# --- 4. GRÁFICO 2: MAPA DE FASE (BETA x GAMMA) ---
print("Gerando Mapa de Fase Beta x Gamma...")
alpha_fixo = 0.80 
res = 20
betas = np.linspace(0.1, 0.7, res)
gammas = np.linspace(0.05, 0.25, res)
B, G = np.meshgrid(betas, gammas)
SSE_bg = np.zeros_like(B)

for r in range(res):
    for c in range(res):
        # Pegamos apenas o componente i (índice 1) do retorno da função
        _, i_sim = solver_sir_final(alpha_fixo, B[r,c], G[r,c], n_dias, 0.1, y_real[0], N_bauru)
        SSE_bg[r,c] = np.sum((y_real - i_sim*N_bauru)**2)

plt.figure(figsize=(10, 8))
plt.contourf(B, G, np.log10(SSE_bg), levels=40, cmap='viridis_r')
plt.colorbar(label='Log10(SSE)')
plt.title(f'Topologia do erro: transmissão (β) vs recuperação (γ)\nFixado α={alpha_fixo}', fontsize=14)
plt.xlabel('Taxa de transmissão (β)'), plt.ylabel('Taxa de recuperação (γ)')
plt.savefig('mapa_fase_beta_gamma.png', dpi=300)
plt.show()
